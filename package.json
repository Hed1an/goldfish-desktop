{
  "name": "goldfish-desktop",
  "version": "0.1.4",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "pack": "electron-builder --win portable",
    "check-update": "\"DeepSeek Harness Desktop.exe\" --check-update"
  },
  "keywords": [],
  "type": "commonjs",
  "productName": "DeepSeek Harness Desktop",
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "^0.1.0-rc.6",
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "com.hed1an.dsh-desktop",
    "productName": "DeepSeek Harness Desktop",
    "asar": false,
    "files": [
      "main.js",
      "preload.js",
      "theme/**",
      "assets/**",
      "node-runtime/**",
      "node_modules/**",
      "splash.html"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "黑金小鲸鱼",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    },
    "npmRebuild": false
  },
  "publish": {
    "provider": "github",
    "owner": "Hed1an",
    "repo": "goldfish-desktop"
  }
}